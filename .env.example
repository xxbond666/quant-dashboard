# ── 必填 ────────────────────────────────────────────────
# Finnhub：搜索兜底 / 报价 / 公司新闻 / 业绩日历主源（免费 60 req/min）
#   申请：https://finnhub.io/register
NEXT_PUBLIC_FINNHUB_API_KEY=

# ── 可选：数据源 ─────────────────────────────────────────
# Alpha Vantage：季度利润表（营收/净利润），免费 25 req/日，已有 24h 落盘缓存
#   申请：https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED：宏观页全部序列（免费）
#   申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── 可选：本地量化后端（不设则量化/分析/决策页显示连接失败，其余功能正常）──
# Python FastAPI 控制台地址（qlib 信号 + TradingAgents 分析）
QUANT_API_BASE=http://127.0.0.1:6901

# TradingAgents 报告根目录（其下每个运行一个子目录，含 complete_report.pdf）
# 默认：./data/reports
TA_REPORTS_DIR=

# qlib 股票池 universe.txt 路径（默认：./data/universe.txt）
QLIB_UNIVERSE_PATH=

# 自选股/预警状态文件（默认：./data/app_state.json）
# 设置后，名称表/营收缓存等派生文件也会落在同目录
APP_STATE_PATH=

# 本地数据根目录（上面各项未设置时的兜底根，默认 ./data）
APP_DATA_DIR=

# ── 可选：本机脚本用（不读 .env，需设为系统/用户环境变量）──────────
# 浏览器代理：TradingView 组件直连不通的地区设置（如 http://127.0.0.1:7897）
# DASH_PROXY=
# 6901 守护脚本路径（start_all.ps1 兜底拉起用）
# DASH_WATCHDOG_PS=
